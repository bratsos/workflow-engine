{
  "name": "workflow-engine-prisma-v6",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma 6 client for the Postgres and SQLite suites, generated from workflow-engine/prisma/schema.prisma",
  "main": "./index.cjs",
  "scripts": {
    "generate": "node ../schema.cjs postgres --url && prisma generate --schema .generated/postgres.prisma",
    "push": "node ../schema.cjs postgres --url && prisma db push --schema .generated/postgres.prisma --skip-generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3"
  }
}
