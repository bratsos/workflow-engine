{
  // Cloudflare Workers - Static Assets (Workers, not Pages).
  // Docusaurus emits fully static HTML to ./build (a file per route plus a
  // 404.html), so this is an assets-only Worker with no `main` entrypoint.
  // Live at https://workflow-engine-docs.bratsos.workers.dev
  //
  // Deploy:  pnpm run cf-deploy    (syncs migrations, builds, then `wrangler deploy`)
  // Preview: pnpm run cf-preview   (builds, then `wrangler dev`)
  // The scripts are cf-deploy/cf-preview, not `deploy`: `pnpm deploy` is a
  // reserved pnpm builtin.
  //
  // Continuous deploys use Cloudflare Workers Builds, connected to the
  // repository in the Cloudflare dashboard, with root directory "/" and the
  // deploy command:
  //   pnpm --filter workflow-engine-docs run cf-deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workflow-engine-docs",
  "compatibility_date": "2026-07-04",
  "assets": {
    "directory": "./build",
    // Docusaurus emits a real 404.html; serve it for unmatched paths.
    "not_found_handling": "404-page"
  }
}
